<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
	id="WebApp_ID" version="4.0">
	<display-name>currency-conveter</display-name>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>

	</welcome-file-list>
	


	<servlet>

		<servlet-name>cal</servlet-name>
		<servlet-class>com.servlet.ConveterServlet</servlet-class>
		
		<init-param>
		<param-name>dollorRate</param-name>
		<param-value>100</param-value>
		</init-param>
		
		<init-param>
		<param-name>poundRate</param-name>
		<param-value>121</param-value>
		</init-param>
		
		<init-param>
		<param-name>euroRate</param-name>
		<param-value>101</param-value>
		</init-param>

	</servlet>

	<servlet-mapping>
		<servlet-name>cal</servlet-name>
		<url-pattern>/calculation</url-pattern>
	</servlet-mapping>

</web-app>